const express = require('express');
const cors = require('cors');

// Try requiring serialport safely so server won't crash if packages are missing
let SerialPort, ReadlineParser;
try {
  SerialPort = require('serialport').SerialPort;
  ReadlineParser = require('@serialport/parser-readline').ReadlineParser;
} catch (e) {
  console.log('[Notice] serialport package not found or optional. Operating in resilient bridge mode.');
}

const app = express();
app.use(cors());
app.use(express.json());

// Global telemetry state
let latestData = {
  temp: 24.5,
  ph: 7.20,
  tds: 180,
  turb: 3.10,
  algae: 3.5,
  risk: 5.0,
  drinkableHours: 52,
  suitability: 'Potable (Safe to Drink)',
  recommendedUses: [
    'Direct Drinking & Cooking',
    'Infant Care & Food Prep',
    'Gardening & Organic Farming',
    'All Household Needs'
  ],
  source: 'Initializing',
  timestamp: new Date().toLocaleTimeString()
};

// ================= PREDICTIVE & USABILITY ENGINE =================
function evaluateWaterQuality(temp, ph, tds, turb, algae, risk) {
  let isDrinkableNow = true;
  let reasons = [];

  // 1. Potability Thresholds (WHO / BIS IS 10500 standards)
  if (ph < 6.5 || ph > 8.5) {
    isDrinkableNow = false;
    reasons.push(ph < 6.5 ? 'Acidic pH' : 'Alkaline pH');
  }
  if (tds > 500) {
    isDrinkableNow = false;
    reasons.push(`High TDS (${Math.round(tds)} ppm > 500 ppm limit)`);
  }
  if (turb < 2.0) { // optical sensor voltage drops as turbidity rises
    isDrinkableNow = false;
    reasons.push('High Suspended Turbidity');
  }
  if (algae > 15.0 || risk > 40.0) {
    isDrinkableNow = false;
    reasons.push('Elevated Cyanobacterial / Algae Risk');
  }

  // 2. Shelf Life / Drinkable Duration Estimation
  let drinkableHours = 0;
  if (isDrinkableNow) {
    const baseTime = 72.0; // 72 hours maximum nominal baseline
    const tempFactor = Math.pow(1.8, Math.max(0, temp - 22.0) / 10.0);
    let stabilityFactor = 1.0 - (risk / 100.0) - (algae / 50.0);
    if (stabilityFactor < 0.15) stabilityFactor = 0.15;

    drinkableHours = Math.round((baseTime / tempFactor) * stabilityFactor);
    if (drinkableHours < 1) drinkableHours = 1;
  }

  // 3. Permitted Alternative Application Matrix
  let recommendedUses = [];
  let suitability = '';

  if (isDrinkableNow) {
    suitability = 'Safe for Direct Drinking';
    recommendedUses = [
      'Direct Drinking & Cooking',
      'Infant Care & Food Preparation',
      'Gardening & Irrigation',
      'Domestic Cleaning & Washing'
    ];
  } else {
    suitability = 'Unsafe for Drinking (' + reasons.join(', ') + ')';

    // Tier 1: Agriculture / Gardening
    if (ph >= 6.0 && ph <= 8.5 && tds <= 1200 && algae < 30.0) {
      recommendedUses.push('Gardening & Irrigation');
    }

    // Tier 2: Domestic washing & mopping
    if (ph >= 6.0 && ph <= 9.0 && tds <= 1000 && turb > 1.4) {
      recommendedUses.push('Floor Mopping & Vehicle Wash');
    }

    // Tier 3: Sanitary flushing & construction
    if (tds <= 2500 && ph >= 5.0 && ph <= 9.5) {
      recommendedUses.push('Toilet Flushing');
      recommendedUses.push('Construction / Concrete Curing');
    }

    // Tier 4: Hazardous
    if (recommendedUses.length === 0) {
      recommendedUses.push('Hazardous: Requires Multi-Stage Industrial Treatment');
    }
  }

  return { drinkableHours, suitability, recommendedUses };
}

// ================= SERIAL PORT HARDWARE INGESTION =================
let hardwareConnected = false;
const TARGET_PORT = 'COM7'; // Change to match your USB-to-UART / STM32 port if different

if (SerialPort && ReadlineParser) {
  try {
    const port = new SerialPort({
      path: TARGET_PORT,
      baudRate: 115200,
      autoOpen: true
    });

    const parser = port.pipe(new ReadlineParser({ delimiter: '\r\n' }));

    port.on('open', () => {
      hardwareConnected = true;
      console.log(`[Serial Hardware] Connected successfully to ${TARGET_PORT} at 115200 baud.`);
    });

    parser.on('data', (rawLine) => {
      try {
        const clean = rawLine.trim();
        if (clean.startsWith('{') && clean.endsWith('}')) {
          const raw = JSON.parse(clean);
          const evaluation = evaluateWaterQuality(
            raw.temp,
            raw.ph,
            raw.tds,
            raw.turb,
            raw.algae,
            raw.risk
          );

          latestData = {
            temp: parseFloat(raw.temp) || 25.0,
            ph: parseFloat(raw.ph) || 7.0,
            tds: parseInt(raw.tds) || 0,
            turb: parseFloat(raw.turb) || 0.0,
            algae: parseFloat(raw.algae) || 0.0,
            risk: parseFloat(raw.risk) || 0.0,
            ...evaluation,
            source: 'Physical STM32 Hardware',
            timestamp: new Date().toLocaleTimeString()
          };
          console.log('[STM32 Hardware Ingest]:', latestData);
        }
      } catch (err) {
        // Skip partial serial frames
      }
    });

    port.on('error', (err) => {
      console.log(`[Serial Hardware] Port ${TARGET_PORT} not ready (${err.message}). Using autonomous live simulator.`);
      hardwareConnected = false;
    });
  } catch (err) {
    console.log('[Serial Hardware] Initialization skipped:', err.message);
  }
}

// ================= FALLBACK ENGINE (KEEPS DASHBOARD LIVE) =================
setInterval(() => {
  if (!hardwareConnected) {
    // Generate realistic fluctuating water readings
    const temp = parseFloat((24.2 + (Math.sin(Date.now() / 10000) * 1.5) + Math.random() * 0.4).toFixed(1));
    const ph = parseFloat((7.2 + (Math.cos(Date.now() / 12000) * 0.3) + Math.random() * 0.1).toFixed(2));
    const tds = Math.floor(190 + Math.sin(Date.now() / 8000) * 30 + Math.random() * 10);
    const turb = parseFloat((3.15 + Math.random() * 0.15).toFixed(2));
    const algae = parseFloat((4.0 + Math.random() * 2.5).toFixed(1));
    const risk = parseFloat((algae * 1.6).toFixed(1));

    const evaluation = evaluateWaterQuality(temp, ph, tds, turb, algae, risk);

    latestData = {
      temp,
      ph,
      tds,
      turb,
      algae,
      risk,
      ...evaluation,
      source: 'Hardware Emulation Bridge',
      timestamp: new Date().toLocaleTimeString()
    };
  }
}, 2000);

// ================= REST API ROUTES FOR FRONTEND =================
app.get('/api/telemetry', (req, res) => {
  res.json(latestData);
});

// Direct test endpoint
app.get('/health', (req, res) => {
  res.json({ status: 'Online', hardwareConnected, latestData });
});

const PORT = 5000;
app.listen(PORT, () => {
  console.log(`====================================================`);
  console.log(` HydroPulse AIoT Backend Server is RUNNING`);
  console.log(` URL: http://localhost:${PORT}/api/telemetry`);
  console.log(` Port: ${PORT}`);
  console.log(` Target Serial Port: ${TARGET_PORT}`);
  console.log(`====================================================`);
});
